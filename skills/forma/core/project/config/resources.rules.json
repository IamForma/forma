  "fbx",
  "obj",
  "blend",
  "zip"
 ],
 "source_ext": [
  "docx",
  "xlsx",
  "drawio",
  "csv",
  "pptx"
 ],
 "text_ext": [
  "md",
  "txt",
  "html",
  "css",
