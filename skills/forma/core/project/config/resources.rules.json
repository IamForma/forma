  "css",
  "js",
  "cjs",
  "json",
  "php",
  "txt"
 ],
 "use_roots": [
  "project"
 ],
 "draft_paths": [
  "^project/work/",
  "(^|/)(drafts?|tmp|temp|черновик[иа]?)/"
 ],
 "draft_names": [
  "^(draft|tmp|temp|черновик)[-_. ]",
  "[-_. ](draft|wip|черновик)\\."
 ],
 "reference_paths": [
  "^project/"
 ],
 "classes": {
  "generated": [
   "^project/cards/[^/]+/assets/"
  ],
  "reference": [
   "^project/(reference|brief|mockups)/"
  ],
  "prompt": [
   "^project/(prompts?|промпты)/",
   "(^|/)prompts?/"
  ],
  "script": [
   "^project/cards/[^/]+/scripts/",
   "^project/scripts/",
   "^project/(?!cards/)[^ ]*/scripts/"
  ],
  "source": [
   "^project/source/"
  ],
  "doc": [
   "^project/.*\\.(md|docx|txt|html)$"
  ],
  "config": [
   "^project/.*\\.(json|cjs|js|css|php)$"
  ],
  "data": [
   "^project/.*\\.(xlsx|xls|ods|drawio|excalidraw|csv|tsv|pptx|xml|ya?ml)$"
  ]
 },
