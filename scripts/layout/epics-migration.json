 "paths": {
  "templates": [
   {
    "from": ".forma/manual/%LANG%/0%N%-%OLD%",
    "to": ".forma/manual/%LANG%/0%N%-%NEW%",
    "langs": [
     "ru",
     "en"
    ],
    "wave": "W1"
   },
   {
    "from": "project/goals/goal-%OLD%",
    "to": "project/goals/goal-%NEW%",
    "wave": "W1"
   }
  ],
  "expectedCount": 27
 },
 "ruleTemplates": [
  {
   "id": "epic-name-marked",
   "desc": "«N. Имя/Маркер» -> «N. Новое имя» (язык нового имени = язык старого)",
   "perLang": true,
   "flags": "gu",
   "pattern": "(?<![\\p{L}\\p{N}_/.])%N%\\.[ \\t]+(?:%OLDNAMES%)/(?:%MARKERS%)(?![\\p{L}\\p{N}_/+])",
   "replacement": "%N%. %NEWNAME%"
  },
  {
   "id": "epic-name-bare-quoted",
   "desc": "«N. Имя» в кавычках",
   "perLang": true,
   "flags": "gu",
   "pattern": "(?<=[«\"“'`])%N%\\.[ \\t]+(?:%OLDNAMES%)%NOTNEW%(?=[»\"”'`])",
   "replacement": "%N%. %NEWNAME%"
  },
  {
   "id": "epic-name-bare-after-epic",
   "desc": "«эпик N. Имя» / «epic N. Name» без кавычек",
   "perLang": true,
   "flags": "gu",
   "pattern": "(?<=(?:[Ээ]пик\\p{L}*|[Ee]pics?)[ \\t]+[«\"“]?)%N%\\.[ \\t]+(?:%OLDNAMES%)%NOTNEW%(?![\\p{L}\\p{N}_/+])",
   "replacement": "%N%. %NEWNAME%"
  },
  {
   "id": "epic-name-marker-only",
   "desc": "«Имя/Маркер» без номера",
   "perLang": true,
   "flags": "gu",
   "pattern": "(?<![\\p{L}\\p{N}_/.-])(?<!\\d+\\.[ \\t]+)(?:%OLDNAMES%)/(?:%MARKERS%)(?![\\p{L}\\p{N}_/+])",
   "replacement": "%NEWNAME%"
  },
  {
   "id": "goal-label",
   "desc": "goal-<старый код> -> goal-<новый код> (метки, каталоги project/goals)",
   "flags": "gu",
   "pattern": "(?<![\\p{L}\\p{N}_-])goal-%OLD%(?![\\p{L}\\p{N}_-])",
   "replacement": "goal-%NEW%"
  },
  {
   "id": "manual-dir",
   "desc": "0N-<старый код> -> 0N-<новый код> (каталоги мануала)",
   "flags": "gu",
   "pattern": "(?<![\\p{L}\\p{N}_-])0%N%-%OLD%(?![\\p{L}\\p{N}_-])",
   "replacement": "0%N%-%NEW%"
  },
  {
   "id": "table-row",
   "desc": "строка таблицы | `код` | …",
   "flags": "gmu",
   "pattern": "^([ \\t]*\\|[ \\t]*)`%OLD%`(?=[ \\t]*\\|)",
   "replacement": "$1`%NEW%`"
  },
  {
   "id": "codes-array",
   "type": "line-array",
   "desc": "строка, где в кавычках/обратных кавычках встречаются ≥3 разных старых кода: заменяются все"
  },
  {
   "id": "kind-flag",
   "desc": "--kind <код>",
   "flags": "gu",
   "pattern": "(--kind[ =]`?)%OLD%(?![\\p{L}\\p{N}_-])",
   "replacement": "$1%NEW%"
  },
  {
   "id": "kind-intro-line",
   "desc": "первая строка README раздела мануала и «**Вид**: `код` ·» в GOAL.md",
   "flags": "gmu",
   "pattern": "^((?:Код вида|Kind code|Code kind|Code type|Code of the kind|Code of the card type|Card type|\\*\\*Вид\\*\\*):[ \\t]*)`%OLD%`(?=[ \\t]*·)",
   "replacement": "$1`%NEW%`"
  },
  {
   "id": "literal-kind-compare",
   "desc": "kind === 'код' / kind !== 'код' в скриптах доски",
   "flags": "gu",
   "pattern": "(kind[ \\t]*[!=]==[ \\t]*)'%OLD%'",
   "replacement": "$1'%NEW%'"
  },
  {
   "id": "literal-lane-get",
   "desc": "laneOf.get('код')",
   "flags": "gu",
   "pattern": "(laneOf\\.get\\()'%OLD%'(?=\\))",
   "replacement": "$1'%NEW%'"
  },
  {
   "id": "literal-table-hint",
   "desc": "подсказка про строки таблицы эпиков в тексте ошибки (| `код` | <лейбл>)",
   "flags": "gu",
   "pattern": "\\| `%OLD%` \\| <лейбл>",
   "replacement": "| `%NEW%` | <лейбл>"
  },
  {
   "id": "quoted-code-in-context",
   "desc": "`код` / 'код' / \"код\" в прозе рядом со словом «эпик/код/вид/метка/kind/lane…». Эвристика: каждое срабатывание уходит в отчёт на просмотр (confirm).",
   "confirm": true,
   "flags": "gu",
   "layers": [
    "!cards-board"
   ],
   "pattern": "([`'\"])%OLD%\\1",
   "replacement": "$1%NEW%$1",
   "needLineContext": "(эпик|epic|\\bкод|\\bcode|\\bkind|\\bвид|метк|\\blabel|\\blane|дорожк|CODES)",
   "lineExclude": [
    "плагин|\\bplugin\\b",
    "(Form|Форм[аы]) \\(`forma`\\)",
    "type: 'goal'",
    "\\['status', ?'goal'",
    "`id`/`goal`/`round`",
    "\\barg\\('goal'"
   ],
   "skipFiles": [
    "(^|/)board\\.js$",
    "(^|/)build-kit-graphs\\.cjs$",
    "(^|/)CHANGELOG.md$",
    "/archive/"
   ]
  },
  {
   "id": "bare-hyphen-code",
   "desc": "result-image / review-image без кавычек и без goal-/0N- (слова с дефисом, почти не значат ничего другого)",
   "confirm": true,
   "flags": "gu",
   "onlyKinds": [
    4,
    9
   ],
   "pattern": "(?<![\\p{L}\\p{N}_/.-])%OLD%(?![\\p{L}\\p{N}_-])",
   "replacement": "%NEW%",
   "skipFiles": [
    "generate-diffui-focus-assets\\.cjs$",
    "^project/theme/"
   ]
  }
 ],
